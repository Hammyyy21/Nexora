# Backend only. Copy to .env at the repository root. Never use a VITE_ key variable.
OPENAI_API_KEY=
# Must support Responses API structured outputs; configurable for your account.
OPENAI_MODEL=gpt-6.1-sol
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AI_TIMEOUT_SECONDS=25
AI_REQUESTS_PER_MINUTE=20
